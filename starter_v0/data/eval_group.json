  "cases": [
    {
      "id": "G01_arxiv_paper_search",
      "phase": "B",
      "suite": "group",
      "query": "Tìm bài báo khoa học mới nhất về LLM reasoning",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "papers",
            "args": {
              "query": "LLM reasoning"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_arxiv_papers",
        "difficulty": "medium",
        "what_it_tests": "Tìm bài báo khoa học → routing sang tool papers (arxiv_search)"
      }
    },
    {
