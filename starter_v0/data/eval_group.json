      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "query": "data privacy",
              "policy_area": "data_privacy"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_company_policy",
        "difficulty": "medium",
        "what_it_tests": "Hỏi chính sách nội bộ → routing sang tool policy với policy_area=data_privacy"
