{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Bộ 10 test case do nhóm thiết kế (5 single-turn, 5 multi-turn) để đánh giá routing, parameter extraction, clarification boundary và multi-turn carryover.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
